{
  "name": "Dadaeyu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:android-release": "node --test scripts/android/release-contract.test.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "db:setup": "node scripts/setup-db.mjs",
    "db:seed": "node scripts/seed-supabase.mjs",
    "db:test": "node scripts/test-supabase.mjs",
    "db:auth:phase1": "node scripts/apply-auth-phase.mjs 1",
    "db:auth:phase2": "node scripts/apply-auth-phase.mjs 2",
    "db:auth:phase3": "node scripts/apply-auth-phase.mjs 3",
    "db:auth:phase4": "node scripts/apply-auth-phase.mjs 4",
    "db:auth:all": "node scripts/apply-auth-phase.mjs all",
    "db:verify-auth": "node scripts/verify-auth-phase.mjs",
    "db:verify-phase4": "node scripts/verify-phase4.mjs",
    "chatbot:tourapi:preview": "node scripts/chatbot/import-tourapi-barrier-free.mjs --dry-run --limit=5",
    "chatbot:tourapi:import": "node scripts/chatbot/import-tourapi-barrier-free.mjs --write",
    "chatbot:daejeon-openapi:preview": "node scripts/chatbot/import-daejeon-openapi.mjs --dry-run --limit=5",
    "chatbot:daejeon-openapi:import": "node scripts/chatbot/import-daejeon-openapi.mjs --write",
    "chatbot:embedding:preview": "node scripts/chatbot/embed-chunks-openai.mjs --dry-run --limit=500",
    "chatbot:embedding:write": "node scripts/chatbot/embed-chunks-openai.mjs --write --limit=500",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "prettier --write"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^6.4.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.108.0",
    "@tiptap/extension-image": "^3.27.4",
    "@tiptap/extension-link": "^3.27.4",
    "@tiptap/pm": "^3.27.4",
    "@tiptap/react": "^3.27.4",
    "@tiptap/starter-kit": "^3.27.4",
    "axios": "^1.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "fast-xml-parser": "^5.9.3",
    "isomorphic-dompurify": "^3.18.0",
    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tts": "^0.1.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "27.0.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5"
  },
  "overrides": {
    "isomorphic-dompurify": {
      "jsdom": "27.0.0"
    },
    "gaxios": "7.3.0",
    "glob": "13.0.6",
    "next": {
      "postcss": "8.5.24",
      "sharp": "0.35.3"
    },
    "@tailwindcss/postcss": {
      "postcss": "8.5.24"
    },
    "postcss": "8.5.24",
    "rimraf": "6.1.3"
  }
}
