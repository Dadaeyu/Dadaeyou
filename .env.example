DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional. `npm run db:setup`에서 누락된 SQL 스키마를 자동 적용할 때만 사용합니다.
SUPABASE_ACCESS_TOKEN=
# Optional. 비워두면 NEXT_PUBLIC_SUPABASE_URL의 호스트에서 자동 추출합니다.
SUPABASE_PROJECT_REF=
SUPABASE_SCHEMA=chatbot
SUPABASE_DOCUMENTS_TABLE=documents
SUPABASE_CHAT_TABLE=chunks

TOUR_API_SERVICE_KEY=
TOUR_API_MOBILE_OS=ETC
TOUR_API_MOBILE_APP=Dadaeyu
PUBLIC_DATA_OPEN_API_SERVICE_KEY=

NEXT_PUBLIC_KAKAO_MAP_API_KEY=
KAKAO_REST_API_KEY=

# Optional. Used only when weather-sensitive chatbot questions need tourism climate data.
# If your data.go.kr account key is approved for the KMA tourism weather API,
# this can reuse the same encoded key as TOUR_API_SERVICE_KEY.
KMA_TOUR_WEATHER_SERVICE_KEY=
KMA_TOUR_WEATHER_CITY_AREA_ID=
KMA_TOUR_WEATHER_ENABLED=true

# Optional. Additional Daejeon OpenAPI data for chatbot RAG en richment.
DAEJEON_PUBLIC_TOILET_SERVICE_KEY=
DAEJEON_CULTURE_TOUR_SERVICE_KEY=
DAEJEON_ACCESSIBLE_PARKING_API_URL=https://www.seogu.go.kr/seoguAPI/3660000/getDspsnParkLcSttus

# Optional. tb_parking 시딩(POST /api/parking/seed)용 대전 공영주차장 API 키.
# 비워두면 PUBLIC_DATA_OPEN_API_SERVICE_KEY(또는 TOUR_API_SERVICE_KEY)를 재사용합니다.
DAEJEON_PARKING_SERVICE_KEY=
# Optional. 비워두면 코드 내 기본값(getParkingInfoList.do)을 사용합니다.
DAEJEON_PARKING_API_URL=

# Optional. Set this to enable OpenAI embedding + pgvector search.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Vercel Cron(매일 자정 KST 장소 동기화) 인증 시크릿.
# 설정하면 /api/cron/place 는 Authorization: Bearer <CRON_SECRET> 헤더가
# 있는 요청만 허용한다(Vercel Cron 이 자동으로 이 헤더를 실어 보냄).
CRON_SECRET=

# Chatbot request protection.
CHAT_RATE_LIMIT_PER_MINUTE=20
# 로그인 사용자는 계정 단위, 비로그인 사용자는 IP와 User-Agent 기반 익명 요청 식별값 단위 일일 요청 상한입니다.
CHAT_DAILY_CLIENT_REQUEST_LIMIT=100
# DeepSeek classifier/final completion 호출 전 적용되는 월간 전체 요청 상한입니다.
CHAT_MONTHLY_GLOBAL_REQUEST_LIMIT=10000
# 운영 환경에서는 반드시 충분히 긴 무작위 문자열을 별도 설정하세요. 미설정 시 production은 503으로 닫힙니다.
CHAT_CLIENT_HASH_SECRET=
# 쉼표로 구분한 추가 허용 Origin. 기본적으로 현재 서비스 Origin은 자동 허용됩니다.
CHAT_ALLOWED_ORIGINS=
# 개발 환경에서만 Supabase chat usage RPC 미설치 시 메모리 fallback을 허용합니다.
CHAT_USAGE_LOCAL_FALLBACK=false
# production에서는 무시됩니다. 비운영에서 true일 때만 /api/chat response.debug가 포함됩니다.
CHAT_DEBUG=false

# Chatbot text-to-speech.
TTS_PROVIDER=google
TTS_RATE_LIMIT_PER_MINUTE=20
# 로그인 사용자는 계정 단위, 비로그인 사용자는 IP와 User-Agent 기반 익명 요청 식별값 단위 일일 상한입니다.
TTS_DAILY_USAGE_LIMIT_PER_CLIENT=50000
# 운영 환경에서는 충분히 긴 무작위 문자열을 별도 설정하세요.
TTS_CLIENT_HASH_SECRET=
# 쉼표로 구분한 추가 허용 Origin. 기본적으로 현재 서비스 Origin은 자동 허용됩니다.
TTS_ALLOWED_ORIGINS=
GOOGLE_TTS_ENABLED=true
GOOGLE_TTS_VOICE=ko-KR-Chirp3-HD-Sulafat
GOOGLE_TTS_SPEED=1.0
# Chirp3-HD 무료 구간 아래에서 멈추도록 월 80만 자를 절대 상한으로 사용합니다.
GOOGLE_TTS_MONTHLY_USAGE_LIMIT=800000
GOOGLE_TTS_CREDENTIALS_JSON=
CHAT_CLIENT_HASH_SECRET=

# 스케줄러 보안
CRON_SECRET=
